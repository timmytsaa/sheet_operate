# sheetops 部署設定（由 deploy/setup.ps1 複製成專案根目錄的 .env）
# 這些都有預設值，通常不用改。

# 服務埠號
SHEETOPS_PORT=8033

# 本機 Ollama 上的模型名稱（ollama list 看得到的那個）
SHEETOPS_MODEL=sheetops

# 本機 Ollama 位址；模型跑在另一台機器時改成 http://<那台的IP>:11434
# （注意：這裡故意不叫 OLLAMA_HOST——那個是訓練用的雲端位址，兩者不可共用）
SHEETOPS_OLLAMA_HOST=http://localhost:11434

# 單次生成上限（秒）與輸出 token 上限——顯卡較慢時可調高秒數
# 真實 BOM（66 列 × 18 欄）實測要 300 秒以上，預設 300 會在跑完前逾時
SHEETOPS_TIMEOUT=600
SHEETOPS_MAX_TOKENS=1400

# 以下只有「訓練/蒸餾」才需要，純部署留空即可
OLLAMA_API_KEY=
